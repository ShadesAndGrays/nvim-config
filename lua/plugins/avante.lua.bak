-- provider docs: https://github.com/yetone/avante.nvim/wiki/Custom-providers
return { {

    "yetone/avante.nvim",
    event        = "VeryLazy",
    version      = false, -- Never set this value to "*"! Never!
    ---@module 'avante'
    ---@type avante.Config

    opts         = {
        -- add any opts here
        --mode                      = "legacy",
        -- this file can contain specific instructions for your project

        provider                  = "ollama",
        auto_suggestions_provider = "ollama",

        -- New 2026 structure: providers are defined here
        providers                 = {
            ollama = {
                ["local"] = true,
                endpoint = "http://172.18.48.1:11434/v1", -- The /v1 is required for OpenAI-compat
                model = "qwen2.5-coder:7b-instruct",
                timeout = 30000,                          -- Local models can be slow
                temperature = 0,
                max_tokens = 4096,
                -- This tells Avante to use OpenAI's logic for parsing,
                -- which Ollama supports perfectly on the /v1 endpoint.
                __inherited_from = "openai",
                api_key_name = "OLLAMA_API_KEY",
                parse_api_key = function() return "ollama" end,
                extra_request_body = {
                    options = {
                        num_ctx = 4096,
                        num_gpu = 99,
                    },
                },
                disable_tools = true,
            },
            gemini = {
                model = "gemini-2.5-flash",
            },

        },
        -- parse_response_data       = function(data_str)
        --     -- This is a fallback to ensure we catch every tiny token
        --     return data_str
        -- end,
        -- parse_stream_data         = function(data)
        --     return data
        -- end,
        behaviour                 = {
            auto_suggestions = false, -- Turn this off if you just want chat speed
            auto_set_highlight_group = true,
            auto_set_keymaps = true,
            auto_apply_diff_after_generation = false,
            support_paste_from_clipboard = false,
            -- CRITICAL: Disable token counting to stop typing lag
            enable_token_counting = false,
        },
        mappings                  = {
            suggestion = {
                accept = "<M-l>", -- Alt + L to accept
                next = "<M-]>",
                prev = "<M-[>",
                dismiss = "<C-]>",
            },
        },
    },
    dependencies = {

        "nvim-lua/plenary.nvim",
        "MunifTanjim/nui.nvim",

        "nvim-tree/nvim-web-devicons",
        "nvim-telescope/telescope.nvim",
        "hrsh7th/nvim-cmp",
    }
} }
